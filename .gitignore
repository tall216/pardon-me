# React Native / Expo
node_modules/
__pycache__/
*.pyc
.expo/
dist/
npm-debug.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
web-build/

# Native build artifacts
#
# NOTE: android/ is deliberately NOT ignored. This project contains
# hand-written native code (IncomingCallModule, StealthTriggerService,
# BootReceiver, CallAlarmReceiver, MainActivity window flags) that cannot be
# regenerated by `expo prebuild`. Ignoring the folder would mean one prebuild
# silently deletes the entire native feature set. Only the build OUTPUT is
# ignored below.
android/app/build/
android/build/
android/.gradle/
android/local.properties
android/.cxx/
# Release signing — never commit the key or its passwords
android/keystore.properties
*.keystore
!android/app/debug.keystore
android/credentials/
*service-account*.json
pardon-me-tuning-*.json
ios/build/
ios/Pods/

# Misc
.DS_Store
*.log
# throwaway device screenshots from debugging sessions
_*.png
